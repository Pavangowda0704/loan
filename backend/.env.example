# Copy this file to .env and fill in your values
# NEVER commit .env to git

PORT=5000

# ── CORS ──────────────────────────────────────────────────────
# Production frontend URL (Vercel)
CLIENT_URL=https://your-app.vercel.app
# Local frontend URL (for localhost dev)
CLIENT_URL_LOCAL=http://localhost:5173

# ── Database (Railway / local MySQL) ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=loanease

# ── Cloudinary (document uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Backend public URL (used to build document preview URLs) ──
# Local:      leave blank (defaults to http://localhost:5000)
# Production: set to your actual Render URL
BACKEND_URL=https://your-backend.onrender.com
